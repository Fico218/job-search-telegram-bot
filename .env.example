# Token del bot de Telegram (obtenerlo en @BotFather)
TELEGRAM_BOT_TOKEN=tu_token_aqui

# Tu Chat ID de Telegram (obtenerlo con @userinfobot)
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# Palabras clave de busqueda (separadas por comas)
SEARCH_KEYWORDS=desarrollador python,python developer,backend developer

# Ubicacion (dejar vacio para busqueda remota/global)
LOCATION=Mexico

# Frecuencia de busqueda en horas
SEARCH_INTERVAL_HOURS=1

# Solo trabajos remotos (true/false)
REMOTE_ONLY=false
